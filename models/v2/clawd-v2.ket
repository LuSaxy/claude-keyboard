              ]
            }
          },
          {
            "cmd": "set_checks",
            "args": {
              "checks": [
                {
                  "expr": "wall-lev_low_t+gap >= 0.9",
                  "kind": "expr",
                  "name": "lever_low_clear",
                  "note": "lower paddle stays >= 0.9 mm from the board edge when pressed (max ~0.6 mm travel at the free end)"
                },
                {
                  "expr": "abs((lev_bot+lev_top)/2-(split+2)) <= 1",
                  "kind": "expr",
                  "name": "lever_centred",
                  "note": "paddle centred near the switch knob and the leaf"
                }
              ]
            }
          }
        ]
      }
