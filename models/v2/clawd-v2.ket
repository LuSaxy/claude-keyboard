                "dip_top"
              ]
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "tools": [
                  "key_open",
                  "mx_hole1",
                  "mx_hole2",
                  "dip_slot1",
                  "dip_slot2",
                  "lev_slot_a_l",
                  "lev_slot_b_l",
                  "lev_slot_c_l",
                  "lev_slot_a_r",
                  "lev_slot_b_r",
                  "lev_slot_c_r"
                ]
