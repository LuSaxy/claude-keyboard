            "args": {
              "parameters": [
                {
                  "expr": 1.2,
                  "name": "shield_t",
                  "description": "battery shield shelf thickness (printable minimum)"
                },
                {
                  "expr": 0.5,
                  "name": "shield_gap",
                  "description": "room above the LiPo for thickness tolerance and swelling"
                },
                {
                  "expr": 4.5,
                  "name": "shield_y1",
                  "description": "shelf ends here, clear of the XIAO (U1 starts at y 5.3)"
                },
                {
                  "expr": "floor+0.2+lipo_t+shield_gap",
                  "name": "shield_z",
                  "description": "underside of the battery shield"
                }
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "battery_shield",
              "note": "shelf between the LiPo and the key sockets K1/K2: key presses land on the shelf and walls, not on the battery; 0.3 mm into the side and front walls",
              "size": [
                "2*cav_x+0.6",
                "shield_y1-cav_y0+0.3",
                "shield_t"
              ],
              "hidden": true,
              "translate": [
                0,
                "(shield_y1+cav_y0-0.3)/2",
                "shield_z"
              ]
            }
