                "lev_hx-(lev_px-1)",
                "body_y1+2-(body_y1-wall-2)",
                "leaf_top+lev_g-(lev_z0-lev_g)"
              ],
              "hidden": true,
              "replace": true,
              "translate": [
                "-(lev_px-1+lev_hx)/2",
                "(body_y1-wall-2+body_y1+2)/2",
                "lev_z0-lev_g"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_slot_c_l",
              "note": "room for the skirt and finger next to the leaf root",
              "size": [
                "lev_skirt_x1+lev_g-(lev_px)",
                "body_y1+2-(body_y1-wall-2)",
                "leaf_top+lev_g-(split-0.1)"
              ],
              "hidden": true,
              "translate": [
                "-(lev_px+lev_skirt_x1+lev_g)/2",
                "(body_y1-wall-2+body_y1+2)/2",
                "split-0.1"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_leaf_l",
              "note": "thin flexure on the outer face: flush with the wall",
              "size": [
                "lev_hx+0.3-(lev_px)",
                "body_y1-(body_y1-leaf_t)",
                "leaf_top-(lev_z0)"
              ],
              "hidden": true,
              "replace": true,
              "translate": [
                "-(lev_px+lev_hx+0.3)/2",
                "(body_y1-leaf_t+body_y1)/2",
                "lev_z0"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_skirt_in_l",
              "note": "closes the gap under the lever, inside the bottom shell lip",
              "size": [
                "lev_skirt_x1-(lev_in)",
                "body_y1-lip_t-lip_c-(sh_y_in)",
                "lev_z0+0.3-(split+0.15)"
              ],
              "hidden": true,
              "translate": [
                "-(lev_in+lev_skirt_x1)/2",
                "(sh_y_in+body_y1-lip_t-lip_c)/2",
                "split+0.15"
