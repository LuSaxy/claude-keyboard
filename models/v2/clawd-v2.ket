    {
      "cmd": "batch",
      "args": {
        "steps": [
          {
            "cmd": "set_parameters",
            "args": {
              "parameters": [
                {
                  "expr": "split-2.5",
                  "name": "lev_bot",
                  "description": "lever paddle bottom: below the split, so the paddle is centred on the switch"
                },
                {
                  "expr": "split+6.5",
                  "name": "lev_top",
                  "description": "lever paddle top"
                },
                {
                  "expr": 1,
                  "name": "lev_low_t",
                  "description": "thickness of the paddle part below the split (keeps 1.1 mm to the board edge)"
                }
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_paddle_r",
              "note": "lever paddle above the split (full wall depth)",
              "size": [
                "lev_px-lev_g-(lev_in)",
                "body_y1-(sh_y_in)",
                "lev_top-(split)"
              ],
              "hidden": true,
              "replace": true,
              "translate": [
                "(lev_in+lev_px-lev_g)/2",
                "(sh_y_in+body_y1)/2",
                "split"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_low_r",
              "note": "lower half of the paddle, in the bottom shell window; thin so it never reaches the board edge",
              "size": [
                "lev_px-lev_g-(lev_in)",
                "body_y1-(body_y1-lev_low_t)",
                "split+0.3-(lev_bot)"
              ],
              "hidden": true,
              "translate": [
                "(lev_in+lev_px-lev_g)/2",
                "(body_y1-lev_low_t+body_y1)/2",
                "lev_bot"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_pad_r",
              "note": "raised press spot, centred on the paddle",
              "size": [
                "lev_in+4.3-(lev_in+0.3)",
                "body_y1+lev_pad_h-(body_y1-0.3)",
                "lev_top-1.5-(lev_bot+1.5)"
              ],
              "hidden": true,
              "replace": true,
              "translate": [
                "(lev_in+0.3+lev_in+4.3)/2",
                "(body_y1-0.3+body_y1+lev_pad_h)/2",
                "lev_bot+1.5"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_win_r",
