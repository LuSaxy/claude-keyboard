              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_skirt_in_r",
              "note": "closes the gap under the lever, inside the bottom shell lip",
              "size": [
                "lev_skirt_x1-(lev_in)",
                "body_y1-lip_t-lip_c-(sh_y_in)",
                "lev_z0+0.3-(split+0.15)"
              ],
              "hidden": true,
              "translate": [
                "(lev_in+lev_skirt_x1)/2",
                "(sh_y_in+body_y1-lip_t-lip_c)/2",
