              "name": "front_cut"
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "tools": [
                  "lev_paddle_l",
                  "lev_root_l",
                  "lev_leaf_l",
                  "lev_finger_l",
                  "lev_pad_l",
                  "lev_paddle_r",
                  "lev_root_r",
                  "lev_leaf_r",
                  "lev_finger_r",
                  "lev_pad_r",
