                },
                {
                  "expr": 0.5,
                  "name": "lbl_d",
                  "description": "how far the labels stand out of the back wall"
                },
                {
                  "expr": 0.4,
                  "name": "lbl_in",
                  "description": "labels sink this far into the wall so they fuse"
                },
                {
                  "expr": "split-2.0",
