    {
      "cmd": "batch",
      "args": {
        "steps": [
          {
            "cmd": "set_parameters",
            "args": {
              "parameters": [
                {
                  "name": "sock_drop",
                  "expr": 2.02,
                  "description": "Kailh socket body below the PCB (from the 3D model; measure yours: about 1.8-2.0 mm)"
                },
                {
                  "name": "sock_gap",
                  "expr": 0.15,
                  "description": "gap between the socket support and the socket: support takes the press, never pre-loads the socket"
                },
                {
                  "name": "ksup_w",
                  "expr": 7,
                  "description": "socket support width (X), inside the 11 mm socket body"
                },
                {
                  "name": "ksup_d",
                  "expr": 3.5,
                  "description": "socket support depth (Y), inside the 6 mm socket body"
                },
                {
                  "name": "ksup_dx",
                  "expr": 0.6,
                  "description": "socket body centre relative to the key centre, X"
                },
                {
                  "name": "ksup_dy",
                  "expr": -3.775,
                  "description": "socket body centre relative to the key centre, Y"
                },
                {
                  "name": "ksup_z0",
                  "expr": "shield_z+shield_t-0.3",
                  "description": "support starts 0.3 mm inside the plate so they fuse"
                },
                {
                  "name": "ksup_h",
                  "expr": "pcb_z-sock_drop-sock_gap-ksup_z0",
                  "description": "support height up to just under the socket"
                }
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "ksup_1",
              "note": "post under the middle of hot-swap socket K1: a key press lands on the plate, not on the socket's solder joints",
              "hidden": true,
              "size": [
                "ksup_w",
                "ksup_d",
                "ksup_h"
              ],
              "translate": [
                "-key_x+ksup_dx",
                "key_y+ksup_dy",
                "ksup_z0"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "ksup_2",
              "note": "post under the middle of hot-swap socket K2",
              "hidden": true,
              "size": [
                "ksup_w",
                "ksup_d",
                "ksup_h"
              ],
              "translate": [
                "key_x+ksup_dx",
                "key_y+ksup_dy",
                "ksup_z0"
              ]
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "name": "battery_plate_u",
              "set": {
                "tools": [
                  "pillar_l",
                  "pillar_c",
                  "pillar_r",
                  "bplate_thin",
                  "bplate_usb",
                  "bplate_left",
                  "ksup_1",
                  "ksup_2"
                ]
              }
            }
          },
          {
            "cmd": "set_checks",
            "args": {
              "checks": [
                {
                  "name": "shield_vs_k1",
                  "kind": "min_distance",
                  "a": "part_K1",
                  "b": "battery_plate",
                  "min": 0.1,
                  "note": "socket support stops just under K1"
                },
                {
                  "name": "shield_vs_k2",
                  "kind": "min_distance",
                  "a": "part_K2",
                  "b": "battery_plate",
                  "min": 0.1,
                  "note": "socket support stops just under K2"
                },
                {
                  "name": "ksup_gap_small",
                  "kind": "expr",
                  "expr": "sock_gap <= 0.3",
                  "note": "support close enough to catch the socket before the PCB flexes much"
                },
                {
                  "name": "ksup_printable",
                  "kind": "expr",
                  "expr": "ksup_h >= 0.6"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "cmd": "set_parameters",
      "args": {
        "parameters": [
          {
            "name": "dip_ch",
            "expr": 0.8,
            "description": "45° chamfer on the outside of the MODE/POWER windows (top and sides; the bottom stays straight above the state icons)"
          }
        ]
      }
    },
    {
      "cmd": "loft",
      "args": {
        "name": "dip_ch_mode_f",
        "note": "chamfer cutter for the switch window: fingernail reaches the knob",
        "hidden": true,
        "sections": [
          {
            "plane": "XZ",
            "offset": "body_y1-dip_ch",
            "profile": {
              "kind": "rect",
              "w": "dip_win_w",
              "h": "dip_top-(dip_cz-dip_win_h/2)",
              "center": [
                "mode_x",
                "(dip_cz-dip_win_h/2+dip_top)/2"
              ]
            }
          },
          {
            "plane": "XZ",
            "offset": "body_y1+0.5",
            "profile": {
              "kind": "rect",
              "w": "dip_win_w+2*(dip_ch+0.5)",
              "h": "dip_top+dip_ch+0.5-(dip_cz-dip_win_h/2)",
              "center": [
                "mode_x",
                "(dip_cz-dip_win_h/2+dip_top+dip_ch+0.5)/2"
              ]
            }
          }
        ],
        "ruled": true
      }
    },
