                  "lev_z0+1-(split+0.15)"
                ],
                "translate": [
                  "evq_x",
                  "(knob_y+lev_rest+sh_y_in+0.3)/2",
                  "split+0.15"
                ]
              },
              "name": "lev_finger_r"
            }
          },
          {
            "cmd": "set_checks",
            "args": {
              "checks": [
                {
                  "expr": "lev_z0 >= split+lip_h+lip_c+0.2",
                  "kind": "expr",
                  "name": "lever_over_lip",
                  "note": "the lever swings above the bottom shell lip"
                },
                {
                  "expr": "evq_x+1.1 <= evq_x+sh_stem_w/2+0.25-0.3",
                  "kind": "expr",
                  "name": "finger_in_notch",
                  "note": "the finger fits the old notch of the printed bottom shell"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "cmd": "batch",
      "args": {
        "steps": [
          {
            "cmd": "set_parameters",
            "args": {
              "parameters": [
                {
                  "expr": 2,
                  "name": "loc_peg_d",
                  "description": "locating peg diameter; the board tab hole is 2.2 mm, so the PCB has ±0.1 mm play"
                },
                {
                  "expr": 1.3,
                  "name": "loc_peg_len",
                  "description": "peg length into the 1.6 mm board (stays above the bottom shell arm)"
                }
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "loc_peg_len+0.3",
              "r": "loc_peg_d/2",
              "name": "loc_peg_l",
              "note": "locating peg: drops into the board tab hole so the PCB cannot slide",
              "hidden": true,
              "translate": [
                "-screw_x",
                "screw_y",
                "pcb_top-loc_peg_len"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "loc_peg_len+0.3",
              "r": "loc_peg_d/2",
              "name": "loc_peg_r",
              "note": "locating peg: drops into the board tab hole so the PCB cannot slide",
              "hidden": true,
              "translate": [
                "screw_x",
                "screw_y",
                "pcb_top-loc_peg_len"
              ]
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "tools": [
                  "key_open",
                  "mx_hole1",
                  "mx_hole2",
                  "dip_slot1",
                  "dip_slot2",
                  "lev_slot_a_l",
                  "lev_slot_b_l",
                  "lev_slot_a_r",
                  "lev_slot_b_r"
                ]
              },
              "name": "front_cut"
            }
          },
          {
            "cmd": "delete_features",
            "args": {
              "names": [
                "head_room0",
                "head_room1"
              ]
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "tools": [
                  "lev_paddle_l",
                  "lev_root_l",
                  "lev_leaf_l",
                  "lev_finger_l",
                  "lev_pad_l",
                  "lev_paddle_r",
                  "lev_root_r",
                  "lev_leaf_r",
                  "lev_finger_r",
                  "lev_pad_r",
                  "lbl_mode",
                  "lbl_power",
                  "lbl_usb",
                  "lbl_ble",
                  "lbl_on",
                  "lbl_off",
                  "loc_peg_l",
                  "loc_peg_r"
                ]
              },
              "name": "front_shell"
            }
          },
          {
            "cmd": "delete_checks",
            "args": {
              "names": [
                "screw_head_room"
              ]
            }
          },
          {
            "cmd": "set_checks",
            "args": {
              "checks": [
                {
                  "expr": "loc_peg_d <= 2.2-0.15 and loc_peg_d >= 2.2-0.3",
                  "kind": "expr",
                  "name": "peg_fits_hole",
                  "note": "0.1 mm radial play in the 2.2 mm tab hole"
                },
                {
                  "expr": "pcb_top-loc_peg_len >= pcb_z+0.2",
                  "kind": "expr",
                  "name": "peg_above_arm",
                  "note": "peg ends inside the board, clear of the bottom shell arm"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "cmd": "batch",
      "args": {
        "steps": [
          {
            "cmd": "set_parameters",
            "args": {
              "parameters": [
                {
                  "expr": "evq_x+1.1",
                  "name": "lev_skirt_x1",
                  "description": "skirt under the lever ends with the finger, |x|"
                },
                {
                  "expr": 0.3,
                  "name": "lev_nc",
                  "description": "clearance to the printed bottom shell notch ends"
                },
                {
                  "expr": "evq_x-(sh_stem_w+0.5)/2",
                  "name": "sh_notch_x0",
                  "description": "old stem notch in the printed bottom shell lip, |x|"
                },
                {
                  "expr": "evq_x+(sh_stem_w+0.5)/2",
                  "name": "sh_notch_x1"
                },
                {
                  "expr": "pcb_top+1.7",
                  "name": "dip_top",
                  "description": "top of the slide switch windows: switch body 1.45 (datasheet) + 0.25"
                }
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_slot_b_r",
              "note": "opening around the flexure leaf only",
              "size": [
                "lev_hx-(lev_px-1)",
                "body_y1+2-(body_y1-wall-2)",
                "leaf_top+lev_g-(lev_z0-lev_g)"
              ],
              "hidden": true,
              "replace": true,
              "translate": [
                "(lev_px-1+lev_hx)/2",
                "(body_y1-wall-2+body_y1+2)/2",
                "lev_z0-lev_g"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_slot_c_r",
              "note": "room for the skirt and finger next to the leaf root",
              "size": [
                "lev_skirt_x1+lev_g-(lev_px)",
                "body_y1+2-(body_y1-wall-2)",
                "leaf_top+lev_g-(split-0.1)"
              ],
              "hidden": true,
              "translate": [
                "(lev_px+lev_skirt_x1+lev_g)/2",
                "(body_y1-wall-2+body_y1+2)/2",
                "split-0.1"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_leaf_r",
              "note": "thin flexure on the outer face: flush with the wall",
              "size": [
