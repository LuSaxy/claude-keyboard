                "lev_z0-lev_g-(split+0.15)"
              ],
              "hidden": true,
              "translate": [
                "(lev_skirt_x1+lev_g+sh_notch_x1-lev_nc)/2",
                "(sh_y_in+body_y1)/2",
                "split+0.15"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_slot_b_l",
