                  "lbl_power",
                  "lbl_usb",
                  "lbl_ble",
                  "lbl_on",
                  "lbl_off",
                  "loc_peg_l",
                  "loc_peg_r",
                  "lev_skirt_in_l",
                  "lev_skirt_out_l",
                  "lev_fill_l",
                  "lev_skirt_in_r",
                  "lev_skirt_out_r",
                  "lev_fill_r",
                  "dip_cover1",
                  "dip_cover2"
                ]
              },
              "name": "front_shell"
            }
          },
          {
            "cmd": "set_checks",
            "args": {
              "checks": [
                {
                  "expr": "dip_top >= pcb_top+1.45+0.2",
                  "kind": "expr",
                  "name": "dip_window_height",
                  "note": "MSK12C02 body is 1.45 mm (datasheet): 0.25 mm above it"
                },
                {
                  "expr": "lev_z0-lev_g >= split+0.15+0.3+lev_g",
                  "kind": "expr",
                  "name": "lever_gap_under",
                  "note": "skirt top and the fixed fill leave the lever free"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "cmd": "batch",
      "args": {
        "steps": [
          {
            "cmd": "set_parameters",
            "args": {
              "parameters": [
                {
                  "expr": 0.35,
                  "name": "snap_r",
                  "description": "snap bump radius: sticks out snap_r-lip_c = 0.2 mm into the lip while closing"
                },
                {
                  "expr": 0.05,
                  "name": "snap_c",
                  "description": "bump to dimple clearance when closed (no preload)"
                },
                {
                  "expr": 8,
                  "name": "snap_len",
                  "description": "length of each snap bump"
                },
                {
                  "expr": "split+1",
                  "name": "snap_z",
                  "description": "bump height: middle of the lip overlap"
                },
                {
                  "expr": 17,
                  "name": "snap_side_y",
                  "description": "side-wall snaps, behind the arms"
                },
                {
                  "expr": "split-2",
                  "name": "lbl_state_z",
                  "description": "USB/BLE and ON/OFF on the bottom shell, below the switch windows"
                },
                {
                  "expr": "split+4.3",
                  "name": "lbl_title_z",
                  "description": "MODE / POWER on the top shell, above the switch windows"
                }
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len",
              "r": "snap_r",
              "axis": "Y",
              "name": "snap_arm_l",
              "note": "snap bump on the top shell skirt: clicks into the dimple in the bottom shell lip",
              "hidden": true,
              "translate": [
                "-(arm_x-(lip_t+lip_c))",
                "screw_y-snap_len/2",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len",
              "r": "snap_r",
              "axis": "Y",
              "name": "snap_arm_r",
              "note": "snap bump on the top shell skirt: clicks into the dimple in the bottom shell lip",
              "hidden": true,
              "translate": [
                "arm_x-(lip_t+lip_c)",
                "screw_y-snap_len/2",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len",
              "r": "snap_r",
              "axis": "Y",
              "name": "snap_side_l",
              "note": "snap bump on the top shell skirt: clicks into the dimple in the bottom shell lip",
              "hidden": true,
              "translate": [
                "-(body_x-(lip_t+lip_c))",
                "snap_side_y-snap_len/2",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len",
              "r": "snap_r",
              "axis": "Y",
              "name": "snap_side_r",
              "note": "snap bump on the top shell skirt: clicks into the dimple in the bottom shell lip",
              "hidden": true,
              "translate": [
                "body_x-(lip_t+lip_c)",
                "snap_side_y-snap_len/2",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len",
              "r": "snap_r",
              "axis": "X",
              "name": "snap_front",
              "note": "snap bump on the top shell skirt: clicks into the dimple in the bottom shell lip",
              "hidden": true,
              "translate": [
                "-snap_len/2",
                "body_y0+(lip_t+lip_c)",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len+0.6",
              "r": "snap_r+snap_c",
              "axis": "Y",
              "name": "snap_dimple_arm_l",
              "hidden": true,
              "translate": [
                "-(arm_x-(lip_t+lip_c))",
                "screw_y-(snap_len+0.6)/2",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len+0.6",
              "r": "snap_r+snap_c",
              "axis": "Y",
              "name": "snap_dimple_arm_r",
              "hidden": true,
              "translate": [
                "arm_x-(lip_t+lip_c)",
                "screw_y-(snap_len+0.6)/2",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len+0.6",
              "r": "snap_r+snap_c",
              "axis": "Y",
              "name": "snap_dimple_side_l",
              "hidden": true,
              "translate": [
                "-(body_x-(lip_t+lip_c))",
                "snap_side_y-(snap_len+0.6)/2",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len+0.6",
              "r": "snap_r+snap_c",
              "axis": "Y",
              "name": "snap_dimple_side_r",
              "hidden": true,
              "translate": [
                "body_x-(lip_t+lip_c)",
                "snap_side_y-(snap_len+0.6)/2",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "cylinder",
            "args": {
              "h": "snap_len+0.6",
              "r": "snap_r+snap_c",
              "axis": "X",
              "name": "snap_dimple_front",
              "hidden": true,
              "translate": [
                "-(snap_len+0.6)/2",
                "body_y0+(lip_t+lip_c)",
                "snap_z"
              ]
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "tools": [
                  "pilot0",
                  "pilot1",
                  "xiao_relief",
                  "bdip1",
                  "bdip2",
                  "bezel_open",
                  "bezel_seat",
                  "bsh_l",
                  "bsh_r",
                  "snap_dimple_arm_l",
                  "snap_dimple_arm_r",
                  "snap_dimple_side_l",
                  "snap_dimple_side_r",
                  "snap_dimple_front"
                ]
              },
              "name": "back_cut"
            }
          },
          {
            "cmd": "rename_feature",
            "args": {
              "to": "back_shell_plain",
              "name": "back_shell",
              "keep_checks": true
            }
          },
          {
            "cmd": "boolean",
            "args": {
              "op": "union",
              "name": "back_shell",
              "note": "bottom shell with raised USB/BLE and ON/OFF under the switch windows",
              "color": "#ff7a1a",
              "tools": [
                "lbl_usb",
                "lbl_ble",
                "lbl_on",
                "lbl_off"
              ],
              "target": "back_shell_plain"
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "tools": [
                  "lev_paddle_l",
                  "lev_root_l",
