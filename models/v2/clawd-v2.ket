            "cmd": "update_feature",
            "args": {
              "set": {
                "tools": [
                  "arm_fill_l",
                  "arm_fill_r",
                  "tongue0",
                  "tongue1",
                  "tongue2",
                  "tongue3",
                  "battery_shield"
                ]
              },
              "name": "back_built"
            }
          },
          {
            "cmd": "set_checks",
            "args": {
              "checks": [
                {
                  "a": "lipo",
                  "b": "battery_shield",
                  "min": 0.3,
                  "kind": "min_distance",
                  "name": "lipo_under_shield",
                  "note": "LiPo slides in under the shelf"
                },
                {
                  "a": "part_K1",
                  "b": "battery_shield",
                  "min": 0.5,
                  "kind": "min_distance",
                  "name": "shield_vs_k1",
                  "note": "hot-swap socket clears the shelf"
                },
                {
                  "a": "part_K2",
                  "b": "battery_shield",
                  "min": 0.5,
                  "kind": "min_distance",
                  "name": "shield_vs_k2"
                },
                {
                  "a": "part_U1",
                  "b": "battery_shield",
                  "min": 0.3,
                  "kind": "min_distance",
                  "name": "shield_vs_xiao"
                },
                {
                  "expr": "shield_t >= 1.2",
                  "kind": "expr",
                  "name": "shield_printable"
                }
              ]
            }
          }
        ]
      }
    },
