          {
            "cmd": "set_group",
            "args": {
              "name": "alt_baski",
              "note": "alt kapak (USB/BLE ve ON/OFF yazılı) + şeffaf USB/LED penceresi",
              "bodies": [
                "back_shell",
                "usb_bezel"
              ]
            }
          },
          {
            "cmd": "set_checks",
            "args": {
              "checks": [
                {
                  "expr": "snap_r-lip_c >= 0.15 and snap_r-lip_c <= 0.3",
                  "kind": "expr",
                  "name": "snap_interference",
                  "note": "enough to click, little enough to close by hand"
                },
                {
                  "expr": "lip_t-(snap_r+snap_c-lip_c) >= 0.6",
                  "kind": "expr",
                  "name": "snap_dimple_wall",
                  "note": "lip left behind each dimple"
                }
              ]
            }
          }
        ]
      }
