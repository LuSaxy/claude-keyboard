                "body_y1-(body_y1-leaf_t)",
                "leaf_top-(lev_z0)"
              ],
              "hidden": true,
              "replace": true,
              "translate": [
                "(lev_px+lev_hx+0.3)/2",
                "(body_y1-leaf_t+body_y1)/2",
