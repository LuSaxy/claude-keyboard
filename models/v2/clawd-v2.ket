        "name": "sh_stem_r"
      }
    },
    {
      "cmd": "update_feature",
      "args": {
        "set": {
          "tools": [
            "pilot0",
            "pilot1",
            "xiao_relief",
            "bdip1",
            "bdip2",
            "bezel_open",
            "bezel_seat",
            "bsh_l",
            "bsh_r"
          ]
        },
        "name": "back_cut"
      }
    },
    {
      "cmd": "set_material",
      "args": {
        "name": "button_grey",
        "note": "shoulder buttons",
        "color": "#8a8d91",
        "preset": "plastic_matte",
        "roughness": 0.6
      }
    },
    {
      "cmd": "assign_material",
      "args": {
        "names": [
          "shoulder_l",
          "shoulder_r"
        ],
        "material": "button_grey"
      }
    },
    {
      "cmd": "update_feature",
      "args": {
        "set": {
          "color": "#8a8d91"
        },
        "name": "shoulder_l"
      }
    },
    {
      "cmd": "update_feature",
      "args": {
        "set": {
          "color": "#8a8d91"
        },
        "name": "shoulder_r"
      }
    },
    {
      "cmd": "update_feature",
      "args": {
        "set": {
          "size": [
            "sh_head_w",
            "sh_head_d",
            "sh_head_h+0.4"
          ],
          "translate": [
            "-evq_x",
            "body_y1+sh_head_d/2+sh_travel",
            "sh_cz-sh_head_h/2-0.4"
          ]
        },
        "name": "sh_head_l"
      }
    },
    {
      "cmd": "update_feature",
      "args": {
        "set": {
          "size": [
            "sh_head_w",
            "sh_head_d",
            "sh_head_h+0.4"
          ],
          "translate": [
            "evq_x",
            "body_y1+sh_head_d/2+sh_travel",
            "sh_cz-sh_head_h/2-0.4"
          ]
        },
        "name": "sh_head_r"
      }
    },
    {
      "cmd": "batch",
      "args": {
        "steps": [
          {
            "cmd": "set_parameters",
            "args": {
              "parameters": [
                {
                  "expr": 0,
                  "name": "pcb_hold_gap",
                  "description": "nominal clearance between each lid support and the top of the PCB; zero is contact, not a spring preload"
                },
                {
                  "expr": 4.8,
                  "name": "screw_head_clear_d",
                  "description": "clearance pocket diameter for optional PCB screw head"
                },
                {
                  "expr": 2.5,
                  "name": "screw_head_clear_h",
                  "description": "clearance above PCB for optional screw head"
                }
              ]
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "note": "PCB tab support: nominally contacts the board when shells close; no elastic preload",
                "size": [
                  "arm_x-wall+0.3-(body_x-0.7)",
                  "arm_y1-arm_y0-2*wall+0.6",
                  "front_z-top_t-pcb_top-pcb_hold_gap+0.1"
                ],
                "translate": [
                  "-screw_x",
                  "screw_y",
                  "pcb_top+pcb_hold_gap"
                ]
              },
              "name": "arm_press_l"
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "note": "PCB tab support: nominally contacts the board when shells close; no elastic preload",
                "size": [
                  "arm_x-wall+0.3-(body_x-0.7)",
                  "arm_y1-arm_y0-2*wall+0.6",
                  "front_z-top_t-pcb_top-pcb_hold_gap+0.1"
                ],
                "translate": [
                  "screw_x",
                  "screw_y",
                  "pcb_top+pcb_hold_gap"
                ]
              },
              "name": "arm_press_r"
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "h": "screw_head_clear_h+0.1",
                "r": "screw_head_clear_d/2",
                "note": "clearance pocket above optional screw head; actual screw head must fit",
                "translate": [
                  "-screw_x",
                  "screw_y",
                  "pcb_top-0.1"
                ]
              },
              "name": "head_room0"
            }
          },
          {
            "cmd": "update_feature",
            "args": {
              "set": {
                "h": "screw_head_clear_h+0.1",
                "r": "screw_head_clear_d/2",
                "note": "clearance pocket above optional screw head; actual screw head must fit",
                "translate": [
                  "screw_x",
                  "screw_y",
                  "pcb_top-0.1"
                ]
              },
              "name": "head_room1"
            }
          },
          {
            "cmd": "set_checks",
            "args": {
              "checks": [
                {
                  "expr": "pcb_hold_gap >= 0 and pcb_hold_gap <= 0.05",
                  "kind": "expr",
                  "name": "pcb_support_gap",
                  "note": "nominal contact: printing and PCB thickness tolerance can still leave a gap or create pressure"
                },
                {
                  "a": "arm_press_l",
                  "b": "board",
                  "kind": "no_overlap",
                  "name": "left_support_no_collision"
                },
                {
                  "a": "arm_press_r",
                  "b": "board",
                  "kind": "no_overlap",
                  "name": "right_support_no_collision"
                },
                {
                  "expr": "screw_head_clear_d >= 4.4 and screw_head_clear_h >= 2.2",
                  "kind": "expr",
                  "name": "screw_head_room",
                  "note": "space only; verify actual screw head dimensions"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "cmd": "batch",
      "args": {
        "steps": [
          {
            "cmd": "set_parameters",
            "args": {
              "parameters": [
                {
                  "name": "shoulder_edge_radius",
                  "expr": 0.7,
                  "description": "round only the outer perimeter of each shoulder button face"
                }
              ]
            }
          },
          {
            "cmd": "rename_feature",
            "args": {
              "name": "shoulder_l",
              "to": "shoulder_raw_l",
              "keep_checks": true
            }
          },
          {
            "cmd": "fillet",
            "args": {
              "name": "shoulder_l",
              "target": "shoulder_raw_l",
              "r": "shoulder_edge_radius",
              "edges": {
                "where": ">Y"
              },
              "color": "#8a8d91",
              "note": "round the exposed button face; leave the sliding stem and switch contact unchanged"
            }
          },
          {
            "cmd": "rename_feature",
            "args": {
              "name": "shoulder_r",
              "to": "shoulder_raw_r",
              "keep_checks": true
            }
          },
          {
            "cmd": "fillet",
            "args": {
              "name": "shoulder_r",
              "target": "shoulder_raw_r",
              "r": "shoulder_edge_radius",
              "edges": {
                "where": ">Y"
              },
              "color": "#8a8d91",
              "note": "round the exposed button face; leave the sliding stem and switch contact unchanged"
            }
          },
          {
            "cmd": "assign_material",
            "args": {
              "material": "button_grey",
              "names": [
                "shoulder_l",
                "shoulder_r"
              ]
            }
          }
        ]
      }
    }
  ]
}
