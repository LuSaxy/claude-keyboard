                "body_y1-(body_y1-lip_t-lip_c-0.1)",
                "lev_z0+0.3-(split+0.15)"
              ],
              "hidden": true,
              "translate": [
                "-(sh_notch_x0+lev_nc+lev_skirt_x1)/2",
                "(body_y1-lip_t-lip_c-0.1+body_y1)/2",
                "split+0.15"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_fill_l",
              "note": "fixed: closes the rest of the old notch under the leaf",
              "size": [
                "sh_notch_x1-lev_nc-(lev_skirt_x1+lev_g)",
                "body_y1-(sh_y_in)",
                "lev_z0-lev_g-(split+0.15)"
              ],
              "hidden": true,
              "translate": [
                "-(lev_skirt_x1+lev_g+sh_notch_x1-lev_nc)/2",
                "(sh_y_in+body_y1)/2",
                "split+0.15"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "dip_slot1",
              "size": [
                "dip_win_w",
                "wall+4",
                "dip_top-(split-0.1)"
              ],
              "hidden": true,
              "replace": true,
              "translate": [
                "mode_x",
                "body_y1",
                "split-0.1"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "dip_cover1",
              "note": "closes the switch window above the knob",
              "size": [
                "dip_win_w-2*lev_nc",
                "body_y1-(sh_y_in)",
                "split+lip_h+lip_c+0.3-(dip_top)"
              ],
              "hidden": true,
              "translate": [
                "mode_x",
                "(sh_y_in+body_y1)/2",
                "dip_top"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "dip_slot2",
              "size": [
                "dip_win_w",
                "wall+4",
                "dip_top-(split-0.1)"
              ],
              "hidden": true,
              "replace": true,
              "translate": [
                "pwr_x",
                "body_y1",
                "split-0.1"
              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "dip_cover2",
              "note": "closes the switch window above the knob",
              "size": [
                "dip_win_w-2*lev_nc",
                "body_y1-(sh_y_in)",
                "split+lip_h+lip_c+0.3-(dip_top)"
              ],
