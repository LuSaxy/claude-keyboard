              ]
            }
          },
          {
            "cmd": "box",
            "args": {
              "name": "lev_skirt_out_r",
              "note": "closes the old stem notch of the bottom shell under the lever",
              "size": [
                "lev_skirt_x1-(sh_notch_x0+lev_nc)",
                "body_y1-(body_y1-lip_t-lip_c-0.1)",
                "lev_z0+0.3-(split+0.15)"
              ],
              "hidden": true,
              "translate": [
                "(sh_notch_x0+lev_nc+lev_skirt_x1)/2",
