      "cmd": "set_parameters",
      "args": {
        "parameters": [
          {
            "name": "lbl_state_z",
            "expr": "split-2.6-dip_ch"
          },
          {
            "name": "dip_ch",
            "expr": 0.8,
            "description": "45° chamfer on the outside of the MODE/POWER windows, all four sides (the state icons sit dip_ch lower to clear it)"
          }
        ]
      }
    },
    {
      "cmd": "loft",
      "args": {
        "name": "dip_ch_mode_f",
        "note": "chamfer cutter for the switch window, all four sides: fingernail reaches the knob",
        "hidden": true,
        "sections": [
          {
            "plane": "XZ",
            "offset": "body_y1-dip_ch",
            "profile": {
              "kind": "rect",
              "w": "dip_win_w",
              "h": "dip_top-(dip_cz-dip_win_h/2)",
              "center": [
                "mode_x",
                "(dip_cz-dip_win_h/2+dip_top)/2"
              ]
            }
          },
          {
            "plane": "XZ",
            "offset": "body_y1+0.5",
            "profile": {
              "kind": "rect",
              "w": "dip_win_w+2*(dip_ch+0.5)",
              "h": "dip_top-(dip_cz-dip_win_h/2)+2*(dip_ch+0.5)",
              "center": [
                "mode_x",
                "(dip_cz-dip_win_h/2+dip_top)/2"
              ]
            }
          }
        ],
        "ruled": true,
        "replace": true
      }
    },
